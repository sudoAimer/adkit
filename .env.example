# 将这些变量导入启动服务的终端；应用不自动读取 .env 文件。
# 权重必须位于运行 FastAPI 的机器上，不会自动联网下载。
ADKIT_DEVICE=cuda
ADKIT_ANOMALYDINO_WEIGHTS=weights/dinov2_vits14/model.safetensors
ADKIT_SUBSPACEAD_WEIGHTS=weights/dinov2_with_registers_giant
ADKIT_SUPERADD_WEIGHTS=weights/dinov3_vits16/model.safetensors
ADKIT_DATA_DIR=web-data
ADKIT_FRONTEND_DIST=frontend/dist
